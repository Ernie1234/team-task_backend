PORT=3000
NODE_ENV=development

MONGO_URI=""

# Signs sign-in cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of this API (optional; defaults to the origin of GOOGLE_CALLBACK_URL, then http://localhost:PORT)
BETTER_AUTH_URL=http://localhost:3000
# Kept as a fallback secret for older setups
SESSION_SECRET="SECRET"
SESSION_EXPIRES_IN='30d'

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google sign-in redirect URI (add it in Google Cloud > Credentials)
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/callback/google

FRONTEND_ORIGIN=http://localhost:5173

MAILTRAP_TOKEN=
MAILTRAP_ENDPOINT=https://send.api.mailtrap.io
MAILTRAP_TEMPLATE_UUID=
# Logs: "json" (default in production) or "pretty"; level: error | warn | info | http | debug
LOG_FORMAT=
LOG_LEVEL=

# Error tracking (optional): https://sentry.io → project → Client Keys (DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1

# GET /metrics needs "Authorization: Bearer <METRICS_TOKEN>" when set (required in production)
METRICS_TOKEN=
